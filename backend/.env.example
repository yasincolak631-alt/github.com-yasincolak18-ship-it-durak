# Veritabanı (yerelde Docker ile Postgres çalıştırıyorsan aşağıdaki gibi olabilir)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/airbnb_clone?schema=public"

# JWT
JWT_SECRET="cok-gizli-bir-anahtar-buraya-degistir"

# Sunucu
PORT=3000
CORS_ORIGIN="http://localhost:3001,http://localhost:8081"

# iyzico (Pazaryeri ürünü) — sandbox anahtarların iyzico Merchant Panel > Ayarlar > API Anahtarları altında.
# Pazaryeri ürünü için iyzico ile "Bize Ulaşın" üzerinden iletişime geçip başvuru yapman gerekiyor.
IYZICO_API_KEY="sandbox-..."
IYZICO_SECRET_KEY="sandbox-..."
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Backend'in kendi adresi — iyzico ödeme sonucu bu adrese (callbackUrl) yönlendirir
BACKEND_URL="http://localhost:3000"

# Ödeme sonrası yönlendirme için web istemcisinin adresi
FRONTEND_URL="http://localhost:3001"

# Platformun her rezervasyondan aldığı hizmet bedeli (%). Host onboarding'i
# tamamladıktan sonraki ödemelerde bu oran otomatik olarak platforma ayrılır.
PLATFORM_FEE_PERCENT=10
